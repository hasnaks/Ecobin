# EcoBin backend local environment
# Primary: hosted PostgreSQL connection string (Neon or any Postgres).
# Get one at https://console.neon.tech → Project → Connection Details → copy the string
# (postgresql://user:password@host/database?sslmode=require)
# Leave empty to fall back to the local SQLite file (backend/data/ecobin.sqlite).
DATABASE_URL=

# Optional overrides
# JWT_SECRET=change-me-in-production
# DB_PATH=./data/ecobin.sqlite
